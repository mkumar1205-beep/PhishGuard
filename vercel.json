{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/analyze/:path*",
      "destination": "https://phishguard-hqku.onrender.com/analyze/:path*"
    },
    {
      "source": "/sandbox/:path*",
      "destination": "https://phishguard-hqku.onrender.com/sandbox/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
